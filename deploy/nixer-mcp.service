[Unit]
Description=Nixer Nix specialist MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alex/repos/nixer
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/alex/repos/nixer/.venv/bin/python /home/alex/repos/nixer/server.py --transport streamable-http --host 127.0.0.1 --port 18187
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
