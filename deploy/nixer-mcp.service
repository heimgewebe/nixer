# Historical reference only. NOT the supported Nixer service after NixOS migration.
# This direct-venv launcher has no NIXER_BROTLI_LIB_DIR from the pinned Nix
# package wrapper and deliberately cannot pass the patched OCI backend probe.
# Use the NixOS nixer-headless.service (or packaged `nix run .#nixer`) instead.
[Unit]
Description=Nixer Nix specialist MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/alex/repos/nixer
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NIXER_DOCKER_BIN=/usr/bin/docker
ExecStartPre=/home/alex/repos/nixer/.venv/bin/python /home/alex/repos/nixer/image_pin.py --pull-missing
ExecStart=/home/alex/repos/nixer/.venv/bin/python /home/alex/repos/nixer/server.py --transport streamable-http --host 127.0.0.1 --port 18187
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target